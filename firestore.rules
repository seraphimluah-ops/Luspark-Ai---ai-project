rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        data.uid is string && data.uid.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidChat(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'model', 'isPinned', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() <= 200 &&
        (!('model' in data) || (data.model is string && data.model.size() <= 64)) &&
        (!('isPinned' in data) || data.isPinned is bool);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'chatId', 'userId', 'role', 'content', 'createdAt']) &&
        data.keys().hasOnly(['id', 'chatId', 'userId', 'role', 'content', 'thoughts', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.chatId is string && data.chatId.size() <= 128 &&
        data.userId == request.auth.uid &&
        (data.role in ['user', 'model', 'system']) &&
        data.content is string && data.content.size() <= 50000 &&
        (!('thoughts' in data) || (data.thoughts is string && data.thoughts.size() <= 50000));
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    // Collection: Chats
    match /chats/{chatId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(chatId) && isValidChat(incoming()) && incoming().id == chatId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(chatId) && isValidChat(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'model', 'isPinned', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(chatId) && existing().userId == request.auth.uid;

      // Subcollection: Messages
      match /messages/{messageId} {
        allow get: if isSignedIn() && existing().userId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().chatId == chatId &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
          existing().userId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().chatId == existing().chatId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'thoughts']);
        allow delete: if isSignedIn() && isValidId(messageId) && existing().userId == request.auth.uid;
      }
    }
  }
}
